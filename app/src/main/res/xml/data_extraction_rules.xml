<?xml version="1.0" encoding="utf-8"?>
<!-- API keys are encrypted with a device-bound Keystore key; backing them up would only produce undecryptable data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
